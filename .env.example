# StepSheet Environment Configuration

# App
PROJECT_NAME="StepSheet"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="stepsheet-dev-secret-key-change-in-production-please-32chars"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL in production, SQLite fallback in local dev)
# For local dev without Postgres:
DATABASE_URL="sqlite:///./stepsheet.db"
# For Docker / production:
# DATABASE_URL="postgresql+asyncpg://stepsheet:stepsheet_secret@postgres:5432/stepsheet"

# Storage (local filesystem abstraction or S3 / MinIO)
STORAGE_BACKEND="local" # "local" or "s3"
LOCAL_STORAGE_DIR="./storage"

# S3 / MinIO settings (if STORAGE_BACKEND=s3)
S3_ENDPOINT_URL="http://minio:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="stepsheet-datasets"
S3_REGION="us-east-1"

# DuckDB / Execution limits
DUCKDB_MEMORY_LIMIT="4GB"
DUCKDB_THREADS=4
PREVIEW_SAMPLE_ROWS=200
MAX_UPLOAD_SIZE_BYTES=524288000 # 500MB

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# LLM Assistant (Optional)
ENABLE_LLM_ASSISTANT=false
LLM_PROVIDER="ollama" # "ollama" | "openai"
LLM_ENDPOINT="http://localhost:11434/v1"
LLM_API_KEY=""
LLM_MODEL="llama3"
