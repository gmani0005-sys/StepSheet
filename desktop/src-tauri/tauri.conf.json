{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StepSheet",
  "version": "1.0.0",
  "identifier": "com.stepsheet.workbench",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node scripts/copy-html.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "StepSheet — No-Code Data Workbench",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "StepSheet",
    "copyright": "© 2026 StepSheet",
    "category": "Productivity",
    "shortDescription": "No-code Excel/CSV formula workbench",
    "longDescription": "StepSheet is a no-code data workbench for building Excel-style formulas and transformations through guided UI steps, exportable to live Excel formulas, SQL, Power Query M and Python.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
